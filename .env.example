# AlloBricolage Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# SESSION & JWT CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-key-min-32-chars-change-me
JWT_SECRET=your-jwt-secret-key-min-32-characters-change-me
JWT_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5002/api/auth/google/callback

# ============================================
# AI SERVICES (Optional - system works without them)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# PAYMENT CONFIGURATION (Optional)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CMI (Moroccan cards)
CMI_MERCHANT_ID=your_cmi_merchant_id
CMI_API_KEY=your_cmi_api_key
CMI_ENDPOINT=https://payment.cmi.co.ma/fim/api

# Cash Plus
CASHPLUS_MERCHANT_ID=your_cashplus_merchant_id
CASHPLUS_API_KEY=your_cashplus_api_key

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5002
NODE_ENV=development
BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173

# ============================================
# FRONTEND API CONFIGURATION
# ============================================
# VITE_API_URL: base for api-client.ts (paths like /auth/login). Defaults to /api in dev.
# In production with separate backend: set to https://api.allobricolage.ma/api
VITE_API_URL=

# VITE_BACKEND_URL: base for apiRequest() (paths already include /api/).
# Leave empty for same-origin (Express serves frontend). Set to backend URL if split deployment.
# Example: VITE_BACKEND_URL=https://api.allobricolage.ma
VITE_BACKEND_URL=
