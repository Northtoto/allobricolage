# AlloBricolage Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# SESSION & JWT CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-key-min-32-chars-change-me
JWT_SECRET=your-jwt-secret-key-min-32-characters-change-me
JWT_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Google Sign-In uses Google Identity Services: the client obtains an ID token
# (credential) and the server verifies it against GOOGLE_CLIENT_ID. The client
# needs VITE_GOOGLE_CLIENT_ID (same value) to render the button.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# REDIS (required for production rate-limiting & account-lockout)
# ============================================
# Without REDIS_URL these use in-memory stores — fine for one long-lived process,
# but ineffective on serverless/multi-instance. Use an Upstash redis:// URL.
REDIS_URL=

# ============================================
# AI SERVICES (Optional - system works without them)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Hugging Face Inference API — powers the AI cost estimator (Qwen2.5-7B-Instruct).
# Without a key, cost estimation falls back to the deterministic rule formula.
# Get a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-hugging-face-token
HF_COST_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============================================
# PAYMENT CONFIGURATION (Optional)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CMI (Moroccan cards)
CMI_MERCHANT_ID=your_cmi_merchant_id
CMI_API_KEY=your_cmi_api_key
CMI_ENDPOINT=https://payment.cmi.co.ma/fim/api

# Cash Plus
CASHPLUS_MERCHANT_ID=your_cashplus_merchant_id
CASHPLUS_API_KEY=your_cashplus_api_key

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5002
NODE_ENV=development
BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173

# ============================================
# FRONTEND API CONFIGURATION
# ============================================
# VITE_BACKEND_URL: backend ORIGIN used by the whole client (api-client + apiRequest).
# Leave EMPTY for same-origin (Vite proxy in dev / Express static / single Vercel deploy).
# Set only for a split deployment, e.g. VITE_BACKEND_URL=https://api.allobricolage.ma
VITE_BACKEND_URL=
